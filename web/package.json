{
  "name": "robustprint-web",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "RobustPrint Virtual Lab: in-browser simulation environment for recycled-feedstock FDM printing (synthetic).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "e2e": "node tests/e2e.mjs",
    "build:artifact": "tsc -b && vite build --mode artifact && node scripts/artifact.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.8"
  }
}
